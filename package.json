{
	"name": "scrollflix",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite --port 3000 --host 0.0.0.0",
		"build": "tsc -b && vite build",
		"analyze": "vite build --mode analyze",
		"preview": "vite preview --port 3000 --host 0.0.0.0",
		"lint": "biome lint .",
		"format": "biome format .",
		"check": "biome check .",
		"check:write": "biome check . --write --unsafe",
		"clean:dist": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:unit:ui": "vitest --ui",
		"test:unit:coverage": "vitest --coverage",
		"test:e2e": "playwright test",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug",
		"media:posters": "node scripts/generate-poster-thumbnails.mjs",
		"media:sprite": "node scripts/generate-poster-sprite.mjs",
		"theme:light": "node scripts/generate-light-theme.mjs",
		"catalog:build": "node scripts/build-catalog.mjs",
		"seo:sitemap": "node scripts/generate-sitemap.js",
		"seo:validate": "node -e \"const fs=require('fs');console.log('robots.txt:');console.log(fs.readFileSync('public/robots.txt','utf8'));console.log('sitemap.xml:',fs.statSync('public/sitemap.xml').size,'bytes')\""
	},
	"dependencies": {
		"@micro-sentry/browser": "^7.1.1",
		"@radix-ui/react-accordion": "^1.2.11",
		"@radix-ui/react-dialog": "^1.1.14",
		"@radix-ui/react-dropdown-menu": "^2.1.15",
		"@radix-ui/react-label": "^2.1.7",
		"@radix-ui/react-radio-group": "^1.3.7",
		"@radix-ui/react-scroll-area": "^1.2.9",
		"@radix-ui/react-select": "^2.2.5",
		"@radix-ui/react-slot": "^1.2.3",
		"@radix-ui/react-switch": "^1.2.5",
		"@radix-ui/react-tooltip": "^1.2.7",
		"@tailwindcss/vite": "^4.1.11",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.525.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-hook-form": "^7.61.1",
		"tailwind-merge": "^3.3.1",
		"tw-animate-css": "^1.3.6",
		"vaul": "^1.1.2"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@playwright/test": "^1.54.2",
		"@testing-library/jest-dom": "^6.6.4",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.1.0",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-basic-ssl": "^2.1.0",
		"@vitejs/plugin-react": "^4.7.0",
		"@vitejs/plugin-react-swc": "^3.11.0",
		"@vitest/coverage-v8": "^3.2.4",
		"jsdom": "^26.1.0",
		"sharp": "^0.35.5",
		"typescript": "~5.8.3",
		"vite": "^7.0.6",
		"vite-bundle-analyzer": "^1.1.0",
		"vitest": "^3.2.4"
	}
}
